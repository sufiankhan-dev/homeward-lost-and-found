# ---------------------------------------------------------------------------
# Homeward environment variables. Copy to .env.local and fill in real values.
# Placeholder values only — never commit real credentials.
# ---------------------------------------------------------------------------

# Better Auth: a long random string (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of the site.
BETTER_AUTH_URL=http://localhost:3000

# Neon PostgreSQL connection string. Leave empty to use the embedded
# local PGlite database stored in .data/pglite (no setup needed).
DATABASE_URL=

# Comma-separated emails that receive the moderator role when they sign up.
ADMIN_EMAILS=

# Optional: enables the AI help assistant. Without it the chatbot uses the
# built-in FAQ engine. Kept on the server only.
ANTHROPIC_API_KEY=

# Vercel Blob read-write token for item photos. Required on serverless
# hosting (e.g. Vercel). Leave empty to store photos in UPLOAD_DIR locally.
BLOB_READ_WRITE_TOKEN=

# Optional: support email shown on the Contact page.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional overrides for local storage locations.
# PGLITE_DIR=.data/pglite
# UPLOAD_DIR=.data/uploads
